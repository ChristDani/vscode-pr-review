{
  "name": "vscode-pr-review",
  "displayName": "vscode-pr-review",
  "description": "Personal extension for pr reviewers",
  "version": "0.0.2",
  "repository": {"url": "https://github.com/ChristDani/vscode-pr-review.git"},
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscode-pr-review-buttons.start",
        "title": "Review: Iniciar revisión de rama"
      },
      {
        "command": "vscode-pr-review-buttons.cleanup",
        "title": "Review: Limpiar revisión"
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.138.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "eslint": "^10.5.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
