{
  "name": "vscode-buttons-pr-review",
  "displayName": "vscode-buttons-pr-review",
  "description": "VS Code extension that simplifies and automates Pull Request reviews using temporary Git branches, non-committed merges, testing, and automatic cleanup.",
  "version": "0.0.2",
  "publisher": "christiandiaz",
  "author": {
    "name": "Christian Daniel Campaña Díaz"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ChristDani/vscode-pr-review.git"
  },
  "license": "MIT",
  "icon": "extico.png",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": ["git", "branch", "review", "pr", "pull request", "vscode", "extension", "review buttons", "git review", "git pr review", "Christian Daniel Campaña Díaz", "ChristDani", "EYTLYR"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscode-pr-review-buttons.start",
        "title": "Review: Iniciar revisión de rama"
      },
      {
        "command": "vscode-pr-review-buttons.cleanup",
        "title": "Review: Limpiar revisión"
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.138.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "eslint": "^10.5.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
